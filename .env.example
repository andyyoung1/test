# UniFi Site Manager cloud API key (generate at https://unifi.ui.com → API Keys)
PROTECT_API_KEY=your-api-key-here
# Leave blank if you only have one console; set to pin a specific console
PROTECT_HOST_ID=

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# How often to poll for new events (seconds)
POLL_INTERVAL=30
